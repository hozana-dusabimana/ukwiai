# ===== UKWI Construction Monitor — Environment Variables =====
# Copy to backend/.env and fill in. Never commit .env to git.

# Database (used by mysql container & backend)
DB_NAME=ukwi_db
DB_USER=ukwi_user
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# Backend
JWT_SECRET_KEY=change_me_to_a_long_random_string_at_least_64_chars_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
MAX_UPLOAD_SIZE_MB=20

# AI service
AI_MODEL_PATH=/app/models/basketball_court_cnn.h5
AI_MODEL_VERSION=1.0.0
AI_INPUT_SIZE=224

# Frontend (compile-time)
VITE_API_BASE_URL=http://localhost:8000/api

# Email (optional — for password reset & alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ukwi.rw

# Alert thresholds
BUDGET_OVERRUN_PERCENT=5.0
DELAY_ALERT_DAYS=7
