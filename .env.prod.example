# ---------------------------------------------------------------------------
# Production environment for docker-compose.prod.yml
#
# Copy to `.env.prod` on the server (mode 600, NEVER committed) and fill in
# real secrets. Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Local loopback ports (127.0.0.1 only; CloudPanel reverse-proxies to these)
# These were free on the shared box at deploy time. Re-check with
# `sudo ss -tlnp | grep :<port>` before reusing on a different host.
BACKEND_PORT=8003
AI_PORT=8004
FRONTEND_PORT=5181

# --- Database (reuse host Percona MySQL on 127.0.0.1:3306; no DB container)
DB_NAME=ukwi_db
DB_USER=ukwi_user
DB_PASSWORD=replace_with_openssl_rand_hex_16

# --- Auth
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI service (heuristic-only on small boxes; flip to 0 on a bigger instance)
AI_FORCE_HEURISTIC=1
AI_DISABLE_OBJDET=1
AI_SERVICE_TIMEOUT=120
#
# OWLv2 object detection (backboard / fence / court) — lets the heuristic reach
# stages 6-7 on finished courts AND reject non-court photos, matching local dev.
# Needs ~1.5-2 GB RAM for the AI container. Check the host has it first:
#     free -h          # want >= ~2 GB available
# Then enable by UNcommenting these three and redeploying:
# AI_REQUIREMENTS=requirements.prod-owlv2.txt
# AI_MEM_LIMIT=2g
# AI_DISABLE_OBJDET=0          # (overrides the =1 above)
# Roll back by re-commenting them and redeploying.

# --- CORS / public origins
# The browser only ever talks to the frontend origin (same-origin via the
# Express proxy), so CORS is not exercised by the app; this list matters only
# for direct cross-origin calls to the API domain.
CORS_ORIGINS=https://ukwiai.isiri.rw,https://api-ukwiai.isiri.rw
BACKEND_PUBLIC_URL=https://ukwiai.isiri.rw

# --- Misc
MAX_UPLOAD_SIZE_MB=20
BUDGET_OVERRUN_PERCENT=5.0
DELAY_ALERT_DAYS=7
