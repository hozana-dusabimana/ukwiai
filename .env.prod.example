# ---------------------------------------------------------------------------
# Production environment for docker-compose.prod.yml
#
# Copy to `.env.prod` on the server (mode 600, NEVER committed) and fill in
# real secrets. Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Local loopback ports (127.0.0.1 only; CloudPanel reverse-proxies to these)
# These were free on the shared box at deploy time. Re-check with
# `sudo ss -tlnp | grep :<port>` before reusing on a different host.
BACKEND_PORT=8003
AI_PORT=8004
FRONTEND_PORT=5181

# --- Database (reuse host Percona MySQL on 127.0.0.1:3306; no DB container)
DB_NAME=ukwi_db
DB_USER=ukwi_user
DB_PASSWORD=replace_with_openssl_rand_hex_16

# --- Auth
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI service
# Keep the trained CNN off: the CNN path has no relevance head and marks every
# image relevant, so the heuristic path is the only one that rejects non-court
# photos.
AI_FORCE_HEURISTIC=1
AI_SERVICE_TIMEOUT=120
#
# OWLv2 object detection (backboard / fence / court) — makes the heuristic's
# relevance gate the STRICT one that rejects non-court photos (a face, food, a
# room), and lets it reach stages 6-7 on finished courts. WITHOUT it the gate is
# lenient and accepts almost any image. Needs ~1.5-2 GB RAM for the AI container;
# the 30 GB d2.xlarge has room, so it is ON by default here. These three must be
# set together (the first is a build arg — the image needs torch/transformers):
AI_REQUIREMENTS=requirements.prod-owlv2.txt
AI_MEM_LIMIT=4g
AI_DISABLE_OBJDET=0
# On a small box, roll back to heuristic-only by setting:
#   AI_REQUIREMENTS=requirements.prod.txt ; AI_MEM_LIMIT=900m ; AI_DISABLE_OBJDET=1
#
# OpenRouter vision-language relevance gate (rejects non-court photos the pixel/
# OWLv2 detectors misread, and gives the primary stage reading). Best-effort and
# fail-open: with no key the service runs exactly as before. Set your key here:
OPENROUTER_API_KEY=sk-or-v1-replace_me
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_ENABLE_VLM=1
OPENROUTER_TIMEOUT=30

# --- CORS / public origins
# The browser only ever talks to the frontend origin (same-origin via the
# Express proxy), so CORS is not exercised by the app; this list matters only
# for direct cross-origin calls to the API domain.
CORS_ORIGINS=https://ukwiai.isiri.rw,https://api-ukwiai.isiri.rw
BACKEND_PUBLIC_URL=https://ukwiai.isiri.rw

# --- Misc
MAX_UPLOAD_SIZE_MB=20
BUDGET_OVERRUN_PERCENT=5.0
DELAY_ALERT_DAYS=7
