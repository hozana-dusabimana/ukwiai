# UKWI Frontend — environment configuration
# Copy to .env (or pass via docker-compose) before starting in production.

# URL the Node/Express proxy uses to reach FastAPI (server-to-server, inside the network)
BACKEND_URL=http://backend:8000

# URL the BROWSER uses to fetch backend assets (image files, swagger docs)
# Use the public hostname / port that the user's browser can reach.
BACKEND_PUBLIC_URL=http://localhost:8000

# Port the Express server listens on inside the container
PORT=3000

# Set NODE_ENV=production for the optimized static + Express runtime.
NODE_ENV=production
